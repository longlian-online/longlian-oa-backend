# 生产环境变量模板。复制为 .env.prod 后填写真实值，勿提交 .env.prod。
# cp .env.prod.example .env.prod
#
# 本文件同时用于：
#   1. compose 插值（APP_IMAGE / APP_TAG / MIGRATION_TAG / APP_PORT）
#   2. 注入 migrate、longlian-oa 容器
#
# MySQL、Redis 等不由 compose 启动，必须指向已有外部实例。
# 密码含特殊字符时，DB_URL / DEV_DB_URL 需 URL 编码。

# ====================== 镜像 ======================
# GHCR（默认）。CNB：docker.cnb.cool/longlian.online/longlian-oa-backend
APP_IMAGE=ghcr.io/longlian-online/longlian-oa-backend
# 建议钉死版本，例如 1.2.3 与 1.2.3-migration
APP_TAG=latest
MIGRATION_TAG=migration-latest
APP_PORT=8080

# ====================== Atlas 迁移（外部 MySQL） ======================
# DEV_DB_URL 必须是可反复清空的专用空库，禁止指向生产业务库。
DB_URL=mysql://user:pass@mysql.example.com:3306/longlian_oa
DEV_DB_URL=mysql://user:pass@mysql.example.com:3306/longlian_oa_atlas_dev

# ====================== MySQL（后端连接，须与 DB_URL 一致） ======================
DB_HOST=mysql.example.com
DB_PORT=3306
DB_DATABASE=longlian_oa
DB_USERNAME=user
DB_PASSWORD=pass

# ====================== Redis（外部） ======================
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# ====================== 邮件通知 ======================
NOTIFY_HOST=
NOTIFY_USERNAME=
NOTIFY_PASSWORD=
NOTIFY_PORT=465
MAIL_STARTTLS=
MAIL_SSL=

# ====================== 数据源 & 缓存 ======================
DATASOURCE_TYPE=mysql
CACHE_TYPE=redis

# ====================== JWT ======================
JWT_SECRET=change-me-to-a-long-random-secret

# ====================== Spring ======================
SPRING_PROFILES_ACTIVE=prod
APP_DEBUG=false
SPRINGDOC_ENABLED=false

# ====================== 存储 ======================
STORAGE_TYPE=LOCAL
# STORAGE_LOCAL_BASE_URL=
# STORAGE_LOCAL_DIRECTORY=
# STORAGE_TYPE=OSS
# STORAGE_OSS_BUCKET=
# STORAGE_OSS_REGION=
# STORAGE_OSS_SECRET_ID=
# STORAGE_OSS_SECRET_KEY=
# STORAGE_OSS_BASE_URL=

# ====================== CORS ======================
CORS_ALLOWED_ORIGINS=https://oa.longlian.online

# ====================== OpenTelemetry（可选，需外部 Collector） ======================
# JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar
# OTEL_SERVICE_NAME=longlian-oa
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
