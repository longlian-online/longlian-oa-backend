# =============================================================================
# longlian-oa 生产环境配置模板
#
# 使用方法：
#   cp devops/application-prod.yml.example devops/application-prod.yml
#   按外部 MySQL / Redis / 邮件 / 存储填写真实值。
#
# 重要：
#   - application-prod.yml 已被 gitignore，禁止提交
#   - compose 把它挂到应用和迁移容器的 /app/config/application.yml
#   - MySQL、Redis、邮件不由 compose 启动，必须指向已有外部实例
#   - 迁移从下方 spring.datasource 推导连接，不必再配 DB_URL
#   - 会在同一实例自动创建 `{数据库名}_atlas` 空库作暂存；
#     账号没有 CREATE DATABASE 时需预先建好，或设 DEV_DB_URL
# =============================================================================

server:
  shutdown: graceful

longlian:
  display-name: "longlian-oa"
  datasource:
    type: mysql
  cache:
    type: redis

spring:
  application:
    name: longlian-oa
  profiles:
    active: prod
  main:
    allow-circular-references: true
  lifecycle:
    timeout-per-shutdown-phase: 30s

  datasource:
    url: jdbc:mysql://mysql.example.com:3306/longlian_oa?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=true&allowPublicKeyRetrieval=true
    username: user
    password: pass

  data:
    redis:
      host: redis.example.com
      port: 6379
      password: ""
      database: 1
  mail:
    host: ""
    username: ""
    password: ""
    # 465 配 ssl.enable=true；587 配 starttls.enable=true
    port: 465
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: false
          ssl:
            enable: true

mybatis-plus:
  global-config:
    db-config:
      logic-delete-field: deletedAt
      logic-delete-value: now()
      logic-not-delete-value: 'null'
  configuration:
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
    default-enum-type-handler: online.longlian.app.common.handler.CodeEnumTypeHandler

debug: false

springdoc:
  swagger-ui:
    path: /swagger-ui.html
    operationsSorter: method
    tagsSorter: alpha
    enabled: false
  api-docs:
    enabled: false

storage:
  # LOCAL | OSS | COS
  type: LOCAL
  local:
    base-url: ""
    signing-secret: ${STORAGE_LOCAL_SIGNING_SECRET:${jwt.secret}}
    read-url-ttl-seconds: 300
    directory: /app/data/storage
  oss:
    bucket: ""
    region: ""
    secret-id: ""
    secret-key: ""
    base-url: ""
  cos:
    bucket: ""
    region: ""
    secret-id: ""
    secret-key: ""
    url-prefix: ""

cors:
  allowed-origins: https://oa.longlian.online

notify:
  type: EMAIL
  email:
    template:
      path: classpath:templates/verify-code.html

jwt:
  # HS256 至少 32 字节。生产必须换成高强度随机串
  secret: change-me-to-a-long-random-secret-at-least-32-bytes
  expiration: 86400
  header: Authorization
  prefix: Bearer
