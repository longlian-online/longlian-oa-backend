# =============================================================================
# longlian-oa 生产环境变量模板
#
# 使用方法：
#   cp devops/.env.example devops/.env
#   按环境填写真实值。
#
# 重要：
#   - devops/.env 已被 gitignore，禁止提交
#   - 主配置仍是 devops/application-prod.yml
#   - 本文件只覆盖 YAML 中用 ${ENV} 引用的项；不存在时使用 YAML 默认值
#   - docker compose -f devops/docker-compose.prod.yml 会读取本目录 .env
#     并注入应用容器
# =============================================================================

# 存储服务生成的预签名 URL 有效期（秒）。过短会增加重新获取链接的频率
STORAGE_PRESIGNED_URL_TTL_SECONDS=300

# 关闭时读取走存储后端原生链接；开启后统一签发 CDN 路径令牌
STORAGE_CDN_ENABLED=false
# EdgeOne 对外访问前缀，不要尾斜杠。例如 https://static.example.com
STORAGE_CDN_URL_PREFIX=
# EdgeOne URL 鉴权 Type D 密钥，需与控制台配置一致
STORAGE_CDN_AUTH_KEY=

# 本地文件短时读取签名密钥。留空则复用 jwt.secret；多实例必须保持一致
STORAGE_LOCAL_SIGNING_SECRET=
