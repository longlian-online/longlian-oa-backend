# =============================================================================
# 生产配置模板（overlays/prod）
#
# 使用：复制为同目录 application-prod.yml 后填写真实值。
# application-prod.yml 已被 .gitignore 忽略，不会提交到仓库，也不会被 git pull 覆盖。
#
# 注意：
#   - spring.datasource.password 必须与 mysql-init.sql 中 IDENTIFIED BY 的密码一致
#   - jwt.secret 必须换成 ≥32 字节的高强度随机串
#   - mysql-init.sql 只在 MariaDB 数据卷首次初始化时执行
#   - 不能把旧 MySQL 8 数据目录直接挂给 MariaDB 10.11
# =============================================================================
# longlian-oa 生产配置（存放于 k8s Secret: longlian-oa-config）
server:
  shutdown: graceful

longlian:
  display-name: "longlian-oa"
  # 对外部署地址；与 Ingress Host 一致，本地文件绝对地址复用这里
  server-url: https://oa.longlian.online
  datasource:
    type: mariadb
  cache:
    type: redis

spring:
  application:
    name: longlian-oa
  profiles:
    active: prod
  main:
    # 现有部分 Bean 存在环依赖，关闭会导致启动失败
    allow-circular-references: true
  lifecycle:
    timeout-per-shutdown-phase: 30s

  datasource:
    # 集群内 MariaDB（见 base/mariadb.yaml）；mysql-init.sql 会创建 longlian 账号
    url: jdbc:mariadb://mariadb:3306/longlian_oa?sslMode=disable&timezone=+08:00
    username: longlian
    # 必须与 mysql-init.sql 中 IDENTIFIED BY 的密码一致
    password: CHANGE_ME_DB_PASSWORD

  data:
    redis:
      # 集群内 Redis（见 base/redis.yaml）
      host: redis
      port: 6379
      # 集群内 Redis 默认不设密码（仅集群网络可达），如启用密码需同时改 Redis args
      password: ""
      database: 1
  mail:
    host: ""
    username: ""
    password: ""
    # 465 配 ssl.enable=true；587 配 starttls.enable=true
    port: 465
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: false
          ssl:
            enable: true

mybatis-plus:
  global-config:
    db-config:
      logic-delete-field: deletedAt
      logic-delete-value: now()
      logic-not-delete-value: 'null'
  configuration:
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
    default-enum-type-handler: online.longlian.app.common.handler.CodeEnumTypeHandler

debug: false

springdoc:
  swagger-ui:
    path: /swagger-ui.html
    operationsSorter: method
    tagsSorter: alpha
    enabled: true
  api-docs:
    enabled: true

storage:
  # LOCAL | OSS | COS
  type: LOCAL
  # 存储服务生成的预签名 URL 有效期（秒）
  presigned-url-ttl-seconds: 300
  # 关闭时读取走存储后端原生链接；开启后统一签发 CDN 路径令牌。
  cdn:
    enabled: false
    url-prefix: ""
    auth-key: ""
    # 与 EdgeOne Type D 控制台有效期必须一致。
    auth-ttl-seconds: 300
    # 同一 URL 在鉴权期内的复用比例；必须介于 1 和 99 之间。
    url-reuse-percent: 80
  local:
    signing-secret: ${jwt.secret}
    directory: /app/data/storage
  oss:
    bucket: ""
    region: ""
    secret-id: ""
    secret-key: ""
    base-url: ""
  cos:
    bucket: ""
    region: ""
    secret-id: ""
    secret-key: ""

cors:
  # 必须包含前端实际 Origin（Ingress 域名或 CDN 域名）
  allowed-origins: https://oa.longlian.online

notify:
  type: EMAIL
  email:
    template:
      path: classpath:templates/verify-code.html

jwt:
  # HS256 至少 32 字节。生产必须换成高强度随机串，泄露等于可伪造登录
  secret: CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES_LONG_RANDOM_STRING
  expiration: 86400
  header: Authorization
  prefix: Bearer