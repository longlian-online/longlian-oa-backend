FROM arigaio/atlas:1.2.3 AS atlas

FROM mariadb:10.11.19
WORKDIR /app/db

# MariaDB 客户端用于同实例自动创建 {db}_atlas 和导入种子。
# 固定 uid/gid：k8s runAsNonRoot 只能校验数字 UID（USER appuser 会被拒绝）。
RUN groupadd --system --gid 998 appgroup \
  && useradd --system --uid 998 --gid appgroup --no-create-home --home-dir /nonexistent appuser

COPY --from=atlas /atlas /usr/local/bin/atlas
COPY --chown=appuser:appgroup db /app/db

USER 998

ENTRYPOINT ["/app/db/migrate.sh"]
CMD ["prod", "apply"]
