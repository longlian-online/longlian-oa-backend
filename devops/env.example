# 生产 Atlas 连接（复制为 devops/.env，已被 gitignore）
#
#   cp devops/env.example devops/.env
#
# 账号须与 application-prod.yml 的 spring.datasource 一致。
# DEV 库必须是可反复清空的专用空库。
# 密码含特殊字符时，mysql:// 连接串需 URL 编码。
#
# 可选：钉死镜像 tag 或改用 CNB
#   APP_IMAGE=ghcr.io/longlian-online/longlian-oa-backend:1.2.3
#   MIGRATION_IMAGE=ghcr.io/longlian-online/longlian-oa-backend:1.2.3-migration
#   # CNB：docker.cnb.cool/longlian.online/longlian-oa-backend

ATLAS_DB_URL=mysql://user:pass@mysql.example.com:3306/longlian_oa
ATLAS_DEV_DB_URL=mysql://user:pass@mysql.example.com:3306/longlian_oa_atlas_dev
